# Build a self-contained Phoenix release; the development Dockerfile is unchanged.
FROM elixir:1.19.7-otp-28-slim@sha256:b0082436839969c6eac09ee99515980322d8ecadd302ff7b9fd6547aa24cddf9 AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV MIX_ENV=prod \
    HEX_CACERTS_PATH=/etc/ssl/certs/ca-certificates.crt

WORKDIR /app
# Optional local cross-architecture emulation workaround; native VPS builds leave empty.
ARG ERL_AFLAGS=""
RUN mix local.hex --force && mix local.rebar --force
COPY mix.exs mix.lock ./
RUN mix deps.get --only prod --check-locked
COPY config ./config
RUN mix deps.compile
COPY assets ./assets
COPY priv ./priv
COPY lib ./lib
RUN mix compile --warnings-as-errors \
    && mix assets.setup \
    && mix assets.deploy \
    && mix release

# The pinned Elixir build image uses Debian trixie; native libraries must match.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl libstdc++6 libncurses6 libatomic1 openssl libsctp1 libodbc2 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system devloom \
    && useradd --system --gid devloom --home-dir /app devloom

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PHX_SERVER=true \
    PORT=4000 \
    ERL_CRASH_DUMP=/tmp/erl_crash.dump

WORKDIR /app
COPY --from=build --chown=devloom:devloom /app/_build/prod/rel/devloom ./
USER devloom
EXPOSE 4000
CMD ["bin/devloom", "start"]
