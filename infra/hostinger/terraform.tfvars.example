# Safe until you have purchased a VPS and configured DNS/SSH.
deploy_enabled = false

# Replace every placeholder below, then set deploy_enabled = true.
vps_host    = "203.0.113.10"
ssh_user    = "root"
ssh_port    = 22
domain      = "devloom.example.com"
acme_email  = "you@example.com"

# Server HOST public key verified through Hostinger's browser console.
ssh_host_key = null

# Null uses ssh-agent (recommended); alternatively set an unencrypted key path.
ssh_private_key_path = null
# ssh_private_key_path = "~/.ssh/devloom_vps"

# Optional: change to force another deployment without code changes.
deployment_revision = "1"
