    {
      "id": 10,
      "title": "Endpoint performance · p50 / p95 / p99",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "description": "Each row is a method + normalized route template. Durations include router pipelines, controller/LiveView rendering and database waits inside dispatch; static files and parsing before routing are excluded. p95 > 500 ms is highlighted for investigation. Idle routes have no percentile estimate. All routed statuses are included.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, method, route) (rate(devloom_http_request_duration_seconds_bucket{job=\"devloom\"}[$__rate_interval]))) and on (method, route) (sum by (method, route) (rate(devloom_http_request_duration_seconds_count{job=\"devloom\"}[$__rate_interval])) > 0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(devloom_http_request_duration_seconds_bucket{job=\"devloom\"}[$__rate_interval]))) and on (method, route) (sum by (method, route) (rate(devloom_http_request_duration_seconds_count{job=\"devloom\"}[$__rate_interval])) > 0)",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, method, route) (rate(devloom_http_request_duration_seconds_bucket{job=\"devloom\"}[$__rate_interval]))) and on (method, route) (sum by (method, route) (rate(devloom_http_request_duration_seconds_count{job=\"devloom\"}[$__rate_interval])) > 0)",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (method, route) (rate(devloom_http_requests_total{job=\"devloom\"}[$__rate_interval]))",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "—",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "—",
                  "color": "gray",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Endpoint"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 470
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests / second"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.5
                    },
                    {
                      "color": "red",
