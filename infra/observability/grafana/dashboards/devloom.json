    {
      "id": 8,
      "title": "Container CPU · percent of one core",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "description": "100% is one CPU core; a container using several cores can exceed 100%. These are Docker container CPU metrics, not total physical Mac CPU usage.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum by (service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",app=\"devloom\",container_label_com_docker_compose_oneoff=\"False\",service=~\"web|db\",cpu=~\"total|\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "—",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
