# Optional: docker compose starts with these local development defaults.
APP_PORT=4000
POSTGRES_USER=devloom
POSTGRES_PASSWORD=devloom_local_password
POSTGRES_DB=devloom_dev

# Optional local observability overlay (see docs/observability.md).
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=devloom_local_grafana
PROMETHEUS_PORT=9090

# Optional private storage for the local recordings overlay (see docs/meetings.md).
# RECORDINGS_S3_BUCKET=
# RECORDINGS_S3_REGION=
# RECORDINGS_S3_ACCESS_KEY_ID=
# RECORDINGS_S3_SECRET_ACCESS_KEY=
# RECORDINGS_S3_ENDPOINT=
# For the local storage overlay, use http://recording-storage.localhost:19000.
# COMPOSE_FILE=compose.yaml:compose.recordings.yaml:compose.recordings.local.yaml
